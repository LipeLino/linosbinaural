{
  "name": "linos-binaural",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build && node scripts/prepare-assets.mjs",
    "preview": "wrangler dev --ip 127.0.0.1 --port 8787",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "assets": "node scripts/generate-art.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "deploy:dry": "wrangler deploy --dry-run",
    "deploy": "node scripts/check-env.mjs --production && node scripts/check-secrets.mjs && wrangler deploy",
    "check:env": "node scripts/check-env.mjs"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "5.3.0",
    "@fontsource/pixelify-sans": "5.3.0",
    "@supabase/supabase-js": "2.117.1",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.1",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "5.0.1",
    "wrangler": "4.137.0"
  }
}
